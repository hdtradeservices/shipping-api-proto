      "type": "string",
      "enum": [
        "FULFILLMENT_ORDER_STATUS_UNSPECIFIED",
        "FULFILLMENT_ORDER_STATUS_NEW",
        "FULFILLMENT_ORDER_STATUS_ACCEPTED",
        "FULFILLMENT_ORDER_STATUS_PARTIALLY_SHIPPED",
        "FULFILLMENT_ORDER_STATUS_SHIPPED",
        "FULFILLMENT_ORDER_STATUS_CANCELLED",
        "FULFILLMENT_ORDER_STATUS_PARTIALLY_CANCELLED",
        "FULFILLMENT_ORDER_STATUS_REJECTED"
      ],
      "default": "FULFILLMENT_ORDER_STATUS_UNSPECIFIED",
      "description": "Status is informational. Do not drive behaviour from it — the queues already\nsay what Zentail wants done, and a status left over from a previous poll is\nhow an integration ends up shipping work it no longer owes.\n\n - FULFILLMENT_ORDER_STATUS_NEW: Routed to you, not yet acknowledged.\n - FULFILLMENT_ORDER_STATUS_ACCEPTED: Acknowledged and awaiting shipment.\n - FULFILLMENT_ORDER_STATUS_REJECTED: You declined it. Zentail reroutes or surfaces it."
    },
